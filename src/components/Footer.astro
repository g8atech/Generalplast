---
import site from "../config/site.json";
---
<footer class="border-t border-border bg-background"><div class="container-page grid gap-12 py-16 md:grid-cols-3"><div><img src={site.brand.logo} alt={site.brand.logoAlt} class="h-12 w-auto" width={site.brand.logoWidth} height={site.brand.logoHeight} loading="lazy" decoding="async"/><p class="mt-5 max-w-xs text-sm leading-relaxed text-muted-foreground">{site.brand.footerText}</p></div><div><h3 class="text-lg font-bold uppercase tracking-wide">Dove trovarci</h3><p class="mt-4 flex items-start gap-2 text-sm text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>{site.contact.addressLine}</p><a href={site.contact.mapsUrl} target="_blank" rel="noreferrer" class="mt-4 inline-block font-display text-xs font-semibold uppercase tracking-[0.16em] text-primary hover:underline">Apri in Google Maps</a></div><div><h3 class="text-lg font-bold uppercase tracking-wide">Contatti</h3><ul class="mt-4 space-y-3 text-sm text-muted-foreground"><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone size-4 text-primary" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg><a href={site.contact.phoneHref} class="hover:text-primary">{site.contact.phone}</a></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-printer size-4 text-primary" aria-hidden="true"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"></path><rect x="6" y="14" width="12" height="8" rx="1"></rect></svg>FAX: {site.contact.fax}</li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail size-4 text-primary" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg><a href={`mailto:${site.contact.email}`} class="hover:text-primary">{site.contact.email}</a></li><li class="pt-1">P.IVA {site.contact.vat}</li></ul></div></div><div class="border-t border-border py-6"><p class="container-page text-center text-xs text-muted-foreground">Copyright © {new Date().getFullYear()} {site.brand.name}. All rights reserved. Created by <a href={site.brand.credit.url} target="_blank" rel="noreferrer" class="text-primary">{site.brand.credit.label}</a></p></div></footer>
